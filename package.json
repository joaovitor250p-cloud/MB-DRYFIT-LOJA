{
  "name": "mb-dryfit-loja",
  "version": "1.0.0",
  "private": true,
  "description": "Código da MB Dryfit e MB For Her, com catálogo, gestão e acesso unificado.",
  "workspaces": [
    "stores/mb-dryfit",
    "stores/mb-for-her"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm test && npm run build",
    "test:hosting": "node --test tests/*.test.mjs",
    "cloudflare:prepare": "node scripts/cloudflare-prepare.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "^4.161.0"
  }
}
